FROM debian:stretch-slim
MAINTAINER Voltha Community <info@opennetworking.org>

# Install pre-requisites
RUN apt-get update -y
RUN apt-get install -y --no-install-recommends git wget libcap-dev build-essential libprotobuf-c1 python-pip python-setuptools && apt-get -y autoremove && apt-get -y autoclean
RUN pip install 'grpc>=0.3' grpcio==1.3.5 grpcio-tools==1.3.5

# Build GRPC PROTOC
ENV PROTOC_PREFIX /usr/local
ENV PROTOC_VERSION "3.3.0"
ENV PROTOC_DOWNLOAD_PREFIX "https://github.com/google/protobuf/releases/download"
ENV PROTOC_DIR protobuf-$PROTOC_VERSION
ENV PROTOC_TARBALL protobuf-python-$PROTOC_VERSION.tar.gz
ENV PROTOC_DOWNLOAD_URI $PROTOC_DOWNLOAD_PREFIX/v$PROTOC_VERSION/$PROTOC_TARBALL
ENV LD_LIBRARY_PATH /usr/local/lib

RUN mkdir -p /build && cd build && \
    wget --no-check-certificate $PROTOC_DOWNLOAD_URI -O - | tar xzvf - && \
    cd $PROTOC_DIR && \
    ./configure --prefix=$PROTOC_PREFIX && \
    make && \
    make install && \
    make clean && \
    cd / && \
    rm -rf build
