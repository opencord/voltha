ARG TAG=latest
FROM opencord/voltha-protos:${TAG} as protos
FROM opencord/voltha-base:${TAG}
MAINTAINER Voltha Community <info@opennetworking.org>

ENV VOLTHA_BASE=/voltha

# Install docker so CLI is available
RUN apt-get update -y 
RUN apt-get install -y curl kafkacat iputils-ping dnsutils jq bridge-utils
RUN curl -sSL http://get.docker.io | CHANNEL=stable bash

COPY . /voltha
RUN rm -rf /voltha/voltha/protos /voltha/ofagent/protos
COPY --from=protos /protos/ /voltha/voltha/protos/
COPY --from=protos /protos/ /voltha/ofagent/protos/
RUN find /voltha/tests -type d -exec touch \{\}/__init__.py \;
RUN find /voltha/voltha/protos -type d -exec touch \{\}/__init__.py \;
RUN find /voltha -name "*.pyc" -exec rm \{\} \;
