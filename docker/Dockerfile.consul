FROM cord/voltha-base

# Create Consul Config Directory
RUN mkdir -p /consul/config 
ENV PYTHONPATH=/consul
COPY consul_config /consul/config

# Exposing process and default entry point
#ENTRYPOINT ["/consul/config/start_service.sh"]
#ENTRYPOINT ["/usr/bin/dumb-init", "/bin/sh /usr/local/bin/docker-entrypoint.sh agent -server -bootstrap -client 0.0.0.0 -ui"]
CMD ["agent -server -bootstrap -client 0.0.0.0 -ui"]
