ARG TAG=latest
FROM opencord/voltha-protos:${TAG} as protos
MAINTAINER Voltha Community <info@opennetworking.org>

COPY voltha/adapters/asfvolt16_olt /asfvolt16_olt
COPY docker/config/build_all_protos.sh  /asfvolt16_olt/protos
COPY --from=protos /protos/third_party /protos/third_party
WORKDIR /asfvolt16_olt/protos
RUN make -f Makefile.docker
