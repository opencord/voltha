[access]
	inheritFrom = All-Projects
[access "refs/*"]
	push = group CORD Committers
	push = group VOLTHA Commit
	forgeAuthor = group CORD Committers
	forgeAuthor = group VOLTHA Commit
	pushMerge = group CORD Committers
	pushMerge = group VOLTHA Commit
	forgeCommitter = group CORD Committers
	forgeCommitter = group VOLTHA Commit
[submit]
	action = rebase if necessary
[access "refs/meta/config"]
	push = group user/Shad Ansari (shad)
	label-Code-Review = -2..+2 group user/Shad Ansari (shad)
	label-Verified = -1..+1 group user/Shad Ansari (shad)
	submit = group user/Shad Ansari (shad)
