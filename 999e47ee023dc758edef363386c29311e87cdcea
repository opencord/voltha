      "writtenOn": "2016-10-27T06:04:45Z",
      "side": 1,
      "message": "See my comments in voltha.yml. If we follow a nesting key approach in voltha.yml, then we can cleanly pass in the relevant config (sub-)snippet to the relevant module, see my comment at line 245 below.",
      "range": {
        "startLine": 218,
        "startChar": 7,
        "endLine": 219,
        "endChar": 65
      },
      "revId": "999e47ee023dc758edef363386c29311e87cdcea",
      "serverId": "2a2bfe1b-c5c2-48ed-9ac8-16438ab24388",
      "unresolved": false
    },
    {
      "key": {
