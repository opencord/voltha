        "filename": "voltha/main.py",
        "patchSetId": 1
      },
      "lineNbr": 245,
      "author": {
        "id": 1000006
      },
      "writtenOn": "2016-10-27T06:04:45Z",
      "side": 1,
      "message": "This shall be\n\nconfig\u003dself.config[\u0027coordinator\u0027],\n\nNice and simple.",
      "range": {
        "startLine": 245,
        "startChar": 12,
        "endLine": 245,
        "endChar": 52
      },
      "revId": "999e47ee023dc758edef363386c29311e87cdcea",
