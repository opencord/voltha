      "writtenOn": "2018-04-19T14:15:19Z",
      "side": 1,
      "message": "Should there be a check to ensure only the OF port status is being changed?",
      "revId": "e21d9e2dbf97eaece7698ea9eab7cc5069804bfa",
      "serverId": "2a2bfe1b-c5c2-48ed-9ac8-16438ab24388",
